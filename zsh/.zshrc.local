# Source this from ~/.zshrc:
# [[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

export VISUAL="nvim"
export EDITOR="nvim"
export LANG="en_AU.UTF-8"
export LC_ALL="en_AU.UTF-8"

export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=10000
export SAVEHIST=10000
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_find_no_dups

alias ls="lsd"
alias l="ls -l"
alias la="ls -a"
alias lla="ls -la"
alias lt="ls --tree"
alias python="python3"
alias v="nvim"
alias zj="zellij"

path=(
  "/opt/homebrew/opt/dotnet@8/bin"
  "$HOME/go/bin"
  "$HOME/.bun/bin"
  $path
)
export PATH

if [[ -d "$HOME/.oh-my-zsh" ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  ZSH_THEME=""
  plugins=(git fzf zoxide)
  source "$ZSH/oh-my-zsh.sh"
fi

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if [[ -r "$(brew --prefix 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if [[ -r "$(brew --prefix 2>/dev/null)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

if [[ -r "/opt/homebrew/opt/chruby/share/chruby/chruby.sh" ]]; then
  source "/opt/homebrew/opt/chruby/share/chruby/chruby.sh"
fi

if [[ -r "/opt/homebrew/opt/chruby/share/chruby/auto.sh" ]]; then
  source "/opt/homebrew/opt/chruby/share/chruby/auto.sh"
fi

if [[ -s "$HOME/.bun/_bun" ]]; then
  source "$HOME/.bun/_bun"
fi
