#!/usr/bin/env bash

echo "DEBUG: Script started at $(date)" > /tmp/debug-popup.log
echo "DEBUG: Working directory: $(pwd)" >> /tmp/debug-popup.log
echo "DEBUG: PATH: $PATH" >> /tmp/debug-popup.log
echo "DEBUG: SHELL: $SHELL" >> /tmp/debug-popup.log
echo "DEBUG: Terminal: $TERM" >> /tmp/debug-popup.log

echo "=== DEBUG POPUP TEST ==="
echo "If you see this, basic echo works"
echo "Working directory: $(pwd)"
echo "Date: $(date)"
echo ""

# Test if the issue is with our main script
echo "Testing main script function..."
if declare -f show_menu > /dev/null; then
    echo "show_menu function exists"
else
    echo "show_menu function NOT found"
fi

echo "DEBUG: About to source main script" >> /tmp/debug-popup.log
source "$HOME/dotfiles/tmux/tmux-sessionizer" 2>>/tmp/debug-popup.log || echo "Failed to source main script"

echo ""
echo "Press any key to continue..."
read -n 1

echo "DEBUG: Script ended at $(date)" >> /tmp/debug-popup.log