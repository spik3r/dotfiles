#!/usr/bin/env bash

echo "=== FZF DEBUG IN TMUX POPUP ==="
echo "Terminal: $TERM"
echo "Columns: $COLUMNS"
echo "Lines: $LINES"
echo "FZF version: $(fzf --version)"
echo ""

items=(
    "test1"
    "test2" 
    "test3"
    "test4"
)

echo "Raw array output:"
printf '%s\n' "${items[@]}"
echo ""

echo "Testing different fzf configurations..."
echo "Press 1-5 to test different options, q to quit"

read -r choice

case $choice in
    1)
        echo "Test 1: Basic fzf"
        printf '%s\n' "${items[@]}" | fzf
        ;;
    2)
        echo "Test 2: No height limit"
        printf '%s\n' "${items[@]}" | fzf --border
        ;;
    3)
        echo "Test 3: Explicit color scheme"
        printf '%s\n' "${items[@]}" | fzf --color=16 --border --height=50%
        ;;
    4)
        echo "Test 4: Force ansi"
        printf '%s\n' "${items[@]}" | fzf --ansi --border --height=50%
        ;;
    5)
        echo "Test 5: No fancy features"
        printf '%s\n' "${items[@]}" | fzf --no-mouse --no-unicode --border
        ;;
    *)
        exit 0
        ;;
esac

echo "Selected: $selected"