#!/usr/bin/env bash

common_dirs=(
    "📁 dotfiles|$HOME/dotfiles"
    "💻 code|$HOME/code"
    "☁️ aws|$HOME/.aws"
    "🐚 zshrc|$HOME/dotfiles/zsh"
    "📥 downloads|$HOME/Downloads"
    "🧠 obsidian|$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/secondBrain"
    "⚙️ config|$HOME/.config"
    "🍺 homebrew|/opt/homebrew"
)

echo "Debug: Array has ${#common_dirs[@]} elements"
echo "Debug: First element: ${common_dirs[0]}"

echo "Running fzf with the array..."
selected=$(printf '%s\n' "${common_dirs[@]}" | fzf \
    --height=60% \
    --border \
    --header="ESC: Back to menu | DEBUG MODE" \
    --prompt="Select common directory: " \
    --delimiter='|' \
    --with-nth=1)

echo "Selected: $selected"
if [[ -n "$selected" ]]; then
    dir_path=$(echo "$selected" | cut -d'|' -f2)
    dir_path="${dir_path/#\~/$HOME}"
    echo "Path would be: $dir_path"
fi