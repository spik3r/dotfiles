#!/usr/bin/env bash

# Simple test script for fzf in tmux popup
echo "Testing basic fzf functionality..."

items=(
    "item1|/path/to/item1"
    "item2|/path/to/item2" 
    "item3|/path/to/item3"
    "dotfiles|$HOME/dotfiles"
)

echo "Array contents:"
printf '%s\n' "${items[@]}"

echo ""
echo "Testing with fzf:"
selected=$(printf '%s\n' "${items[@]}" | fzf \
    --height=60% \
    --border \
    --delimiter='|' \
    --with-nth=1 \
    --prompt="Test: ")

echo "Selected: $selected"