#!/usr/bin/env bash

# LAZYMUX - Complete version with all features

selected=""
include_hidden=false

search_dirs=(
    ~/
    ~/Desktop
    ~/Documents
    ~/Downloads
    ~/projects
    ~/work
    ~/dev
)

show_help() {
    echo "LAZYMUX - tmux session manager"
    echo ""
    echo "Usage: tmux-sessionizer [OPTIONS] [DIRECTORY]"
    echo ""
    echo "Lazy tmux session management, inspired by lazygit"
    echo ""
    echo "OPTIONS:"
    echo "  -h, --help      Show this help message"
    echo "  -c, --current   Create session in current directory"
    echo "  -d, --dir DIR   Create session in specific directory"
    echo "  -i, --interactive  Show interactive menu (default when no args)"
    echo ""
    echo "EXAMPLES:"
    echo "  tmux-sessionizer                    # Show interactive menu"
    echo "  tmux-sessionizer -c                 # Create session in current directory"
    echo "  tmux-sessionizer -d ~/projects/app  # Create session in specific directory"
    echo "  tmux-sessionizer ~/projects/app     # Create session in specific directory"
}

create_session() {
    local dir="$1"

    if [[ ! -d "$dir" ]]; then
        echo "Directory does not exist: $dir"
        exit 1
    fi

    local session_name=$(basename "$dir" | tr . _)
    local tmux_running=$(pgrep tmux)

    if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
        tmux new-session -s "$session_name" -c "$dir"
        exit 0
    fi

    if ! tmux has-session -t="$session_name" 2> /dev/null; then
        tmux new-session -ds "$session_name" -c "$dir"
    fi

    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$session_name"
    else
        tmux switch-client -t "$session_name"
    fi
}

find_dirs_with_hidden() {
    for entry in "${search_dirs[@]}"; do
        [[ -d "$entry" ]] && find "$entry" -mindepth 1 -maxdepth 3 -type d 2>/dev/null
    done
}

find_dirs_no_hidden() {
    for entry in "${search_dirs[@]}"; do
        [[ -d "$entry" ]] && find "$entry" -mindepth 1 -maxdepth 3 -type d -name ".*" -prune -o -type d -print 2>/dev/null
    done
}

fuzzy_finder() {
    if ! command -v fzf &> /dev/null; then
        echo "fzf is required. Install with: brew install fzf"
        exit 1
    fi

    while true; do
        local header="CTRL-H: Toggle hidden folders"
        local prompt="Select directory"

        if [[ "$include_hidden" == "true" ]]; then
            header="$header (showing hidden) | ESC: Back to menu"
            prompt="$prompt (with hidden): "
            local selected_dir=$(find_dirs_with_hidden | fzf \
                --height=80% \
                --border \
                --header="$header" \
                --bind="ctrl-h:abort" \
                --prompt="$prompt")
        else
            header="$header (hidden folders filtered) | ESC: Back to menu"
            prompt="$prompt: "
            local selected_dir=$(find_dirs_no_hidden | fzf \
                --height=80% \
                --border \
                --header="$header" \
                --bind="ctrl-h:abort" \
                --prompt="$prompt")
        fi

        local exit_code=$?

        if [[ $exit_code -eq 130 ]]; then
            # CTRL-C or ESC pressed - back to menu
            show_menu
            return
        elif [[ $exit_code -eq 1 ]]; then
            # CTRL-H pressed (abort) - toggle hidden and continue loop
            if [[ "$include_hidden" == "true" ]]; then
                include_hidden=false
            else
                include_hidden=true
            fi
            continue
        elif [[ -n "$selected_dir" ]]; then
            # Directory selected
            create_session "$selected_dir"
            return
        else
            # Empty selection - back to menu
            show_menu
            return
        fi
    done
}

handle_choice() {
    local choice="$1"

    case $choice in
        1)
            create_session "$(pwd)"
            ;;
        2)
            fuzzy_finder
            ;;
        d)
            create_session "$HOME/dotfiles"
            ;;
        c)
            create_session "$HOME/code"
            ;;
        z)
            create_session "$HOME/dotfiles/zsh"
            ;;
        a)
            create_session "$HOME/.aws"
            ;;
        o)
            create_session "$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/secondBrain"
            ;;
        w)
            create_session "$HOME/Downloads"
            ;;
        h)
            if [[ "$include_hidden" == "true" ]]; then
                include_hidden=false
            else
                include_hidden=true
            fi
            show_menu
            ;;
        q|Q)
            exit 0
            ;;
        *)
            show_menu
            ;;
    esac
}

show_menu() {
    local hidden_status=$([[ "$include_hidden" == "true" ]] && echo "ON " || echo "OFF")

    # Clear screen, reset cursor, and hide cursor
    printf '\033[2J\033[H\033[?25l'

    # Colors
    local cyan='\033[36m'
    local green='\033[32m'
    local yellow='\033[33m'
    local blue='\033[34m'
    local magenta='\033[35m'
    local reset='\033[0m'
    local bold='\033[1m'

    # ASCII art heading with more space
    echo
    echo
    printf " ${cyan}${bold}██╗      █████╗ ███████╗██╗   ██╗███╗   ███╗██╗   ██╗██╗  ██╗${reset}\n"
    printf " ${cyan}${bold}██║     ██╔══██╗╚══███╔╝╚██╗ ██╔╝████╗ ████║██║   ██║╚██╗██╔╝${reset}\n"
    printf " ${cyan}${bold}██║     ███████║  ███╔╝  ╚████╔╝ ██╔████╔██║██║   ██║ ╚███╔╝${reset}\n"
    printf " ${cyan}${bold}███████╗██║  ██║███████╗   ██║   ██║╚██╔╝██║╚██████╔╝██╔╝ ██╗${reset}\n"
    printf " ${cyan}${bold}╚══════╝╚═╝  ╚═╝╚══════╝   ╚═╝   ╚═╝ ╚═╝ ╚═╝ ╚═════╝ ╚═╝  ╚═╝${reset}\n"
    echo
    echo

    # Two column layout with properly aligned borders
    echo "  ╭─ Actions ─────────────╮   ╭─ Quick Access ────────╮"
    printf "  │${green} 1${reset}  Current Directory  │   │${blue} d${reset}  dotfiles           │\n"
    printf "  │${green} 2${reset}  Fuzzy Finder       │   │${blue} c${reset}  code               │\n"
    printf "  │                       │   │${blue} z${reset}  zshrc              │\n"
    printf "  │                       │   │${blue} a${reset}  aws                │\n"
    printf "  │                       │   │${blue} o${reset}  obsidian           │\n"
    printf "  │                       │   │${blue} w${reset}  downloads          │\n"
    echo "  ╰───────────────────────╯   ╰───────────────────────╯"
    echo

    echo "  ╭─ Options ─────────────────────────────────────────╮"
    printf "  │${magenta} h${reset}  Toggle hidden: ${yellow}%-3s${reset}     ${magenta}q${reset}  Quit                 │\n" "$hidden_status"
    echo "  ╰───────────────────────────────────────────────────╯"

    read -n 1 -r choice
    # Show cursor again before handling choice
    printf '\033[?25h'
    handle_choice "$choice"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -c|--current)
            selected=$(pwd)
            shift
            ;;
        -d|--dir)
            selected="$2"
            shift 2
            ;;
        -i|--interactive)
            show_menu
            exit 0
            ;;
        -*)
            echo "Unknown option $1"
            show_help
            exit 1
            ;;
        *)
            selected="$1"
            shift
            ;;
    esac
done

# If directory specified via CLI, use it
if [[ -n "$selected" ]]; then
    create_session "$selected"
else
    # Default to interactive menu
    show_menu
fi
