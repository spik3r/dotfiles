#!/usr/bin/env bash

# Simple working version of LAZYMUX

create_session() {
    local dir="$1"
    
    if [[ ! -d "$dir" ]]; then
        echo "Directory does not exist: $dir"
        exit 1
    fi

    local session_name=$(basename "$dir" | tr . _)
    local tmux_running=$(pgrep tmux)

    if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
        tmux new-session -s "$session_name" -c "$dir"
        exit 0
    fi

    if ! tmux has-session -t="$session_name" 2> /dev/null; then
        tmux new-session -ds "$session_name" -c "$dir"
    fi

    if [[ -z $TMUX ]]; then
        tmux attach-session -t "$session_name"
    else
        tmux switch-client -t "$session_name"
    fi
}

# Simple menu
echo "╭─ LAZYMUX ─────────────────────────╮"
echo "│       tmux session manager       │"
echo "╰───────────────────────────────────╯"
echo
echo "╭─ Actions ─────────────────────────╮"
echo "│  1  Current Directory             │"
echo "│  2  Fuzzy Finder                  │"
echo "╰───────────────────────────────────╯"
echo
echo "╭─ Quick Access ────────────────────╮"
echo "│  d  dotfiles                      │"
echo "│  c  code                          │"
echo "│  z  zshrc                         │"
echo "│  q  Quit                          │"
echo "╰───────────────────────────────────╯"
echo
echo -n "❯ "

read -r choice

case $choice in
    1)
        create_session "$(pwd)"
        ;;
    2)
        if command -v fzf &> /dev/null; then
            selected=$(find ~/ ~/code ~/projects -mindepth 1 -maxdepth 2 -type d 2>/dev/null | fzf --height=50% --border)
            if [[ -n "$selected" ]]; then
                create_session "$selected"
            fi
        else
            echo "fzf not found"
        fi
        ;;
    d)
        create_session "$HOME/dotfiles"
        ;;
    c)
        create_session "$HOME/code"
        ;;
    z)
        create_session "$HOME/dotfiles/zsh"
        ;;
    q|Q)
        exit 0
        ;;
    *)
        echo "Invalid option"
        ;;
esac