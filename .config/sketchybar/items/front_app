# Add spacer after workspace apps to ensure proper spacing
# Add front app (active app) with highlighting
sketchybar --add item front_app left \
           --subscribe front_app front_app_switched \
           --set front_app \
                 icon.drawing=off \
                 label.color="$TEXT_HIGHLIGHT_COLOR" \
                 label.padding_left=8 \
                 label.padding_right=8 \
                 background.drawing=on \
                 background.height=32 \
                 script="$PLUGIN_DIR/front_app.sh"

sketchybar --add item active_monitor left \
           --subscribe active_monitor change-workspace-monitor \
           --set active_monitor \
                 icon.drawing=off \
                 label.color="$TEXT_HIGHLIGHT_COLOR" \
                 label.padding_left=8 \
                 label.padding_right=8 \
                 background.drawing=on \
                 background.height=32 \
                 script="$PLUGIN_DIR/front_app.sh"
# Add pipe separator
sketchybar --add item pipe_separator left \
           --set pipe_separator \
                 icon.drawing=off \
                  label="│" \
                  label.color="0x66$(echo $TEXT_COLOR | cut -c4-)" \
                  label.padding_left=8 \
                  label.padding_right=8 \
                  label.font="$LABEL_FONT" \
                  background.drawing=off
# Add other apps in workspace
sketchybar --add item other_apps left \
           --subscribe other_apps front_app_switched \
           --set other_apps \
                 icon.drawing=off \
                 label.color="$TEXT_COLOR" \
                 label.padding_left=8 \
                 label.padding_right=8 \
                 background.drawing=off \
                 script="$PLUGIN_DIR/other_apps.sh"

# Group all app items in a bracket with unified styling
sketchybar --add bracket app_group active_monitor front_app pipe_separator other_apps \
           --set app_group \
                 background.drawing=on \
                 background.color="$ITEM_BG_COLOR" \
                  background.border_color="$SECTION_BORDER_COLOR" \
                  background.border_width="$SECTION_BORDER_WIDTH" \
                  background.corner_radius="$ITEM_CORNER_RADIUS" \
                  background.height="$ITEM_HEIGHT" \
                  background.clip=0.0 \

                  background.padding_left=12 \
                  background.padding_right=12# Add spacer after app group to ensure proper spacing
sketchybar --add item apps_spacer left \
           --set apps_spacer \
                 icon.drawing=off \
                 label.drawing=off \
                 background.drawing=off \
                 width=40
