#!/usr/bin/env bash

source "$CONFIG_DIR/current-theme"

sketchybar --add event aerospace_workspace_change

sketchybar --add item left_edge_spacer left \
  --set left_edge_spacer \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=off \
  width=4

if command -v aerospace >/dev/null 2>&1; then
  WORKSPACES=($(aerospace list-workspaces --all 2>/dev/null))
fi

if [ ${#WORKSPACES[@]} -eq 0 ]; then
  WORKSPACES=(1 2 3 4 5 6 7 8 9 A B C D M O R S T V)
fi

WORKSPACE_ITEMS=()
for workspace in "${WORKSPACES[@]}"; do
  item_name="workspace.$workspace"
  WORKSPACE_ITEMS+=("$item_name")

  sketchybar --add item "$item_name" left \
    --subscribe "$item_name" aerospace_workspace_change \
    --set "$item_name" \
    icon.drawing=off \
    label="$workspace" \
    label.align=center \
    label.font="$LABEL_FONT" \
    label.color="$TEXT_COLOR" \
    label.padding_left=8 \
    label.padding_right=8 \
    background.drawing=on \
    background.color=0x00000000 \
    background.border_width=0 \
    background.corner_radius=8 \
    background.height=28 \
    click_script="aerospace workspace $workspace" \
    script="$PLUGIN_DIR/aerospace.sh $workspace"
done

sketchybar --add bracket workspaces "${WORKSPACE_ITEMS[@]}" \
  --set workspaces \
  background.drawing=on \
  background.color="$ITEM_BG_COLOR" \
  background.border_color="$SECTION_BORDER_COLOR" \
  background.border_width=1 \
  background.corner_radius=10 \
  background.height=34 \
  background.padding_left=6 \
  background.padding_right=6

sketchybar --add item workspace_spacer left \
  --set workspace_spacer \
  icon.drawing=off \
  label.drawing=off \
  background.drawing=off \
  width=10
