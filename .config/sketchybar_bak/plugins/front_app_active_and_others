#!/usr/bin/env bash

if [ "$SENDER" = "front_app_switched" ]; then
  json=$(aerospace list-windows --workspace focused --json)

# Fallback in case json is empty or invalid
if [ -z "$json" ] || [ "$json" = "null" ]; then
  sketchybar --set "$NAME" label="(no windows)"
  exit 0
fi

# Extract focused app name
focused_app=$(echo "$json" | jq -r '.[] | select(.focused == true) | ."app-name"')

# Extract all app names, deduplicated and sorted
all_apps=$(echo "$json" | jq -r '.[]."app-name"' | sort -u)

label=""
for app in $all_apps; do
  if [ "$app" = "$focused_app" ]; then
    continue  # skip focused app from this loop
  fi
  label+="$app · "
done

# Remove trailing " · "
label="${label% · }"

# Compose final label
if [ -n "$focused_app" ]; then
  full_label=" $focused_app"
  [ -n "$label" ] && full_label+=" | $label"
else
  full_label="$label"
fi

# Output to SketchyBar
sketchybar --set "$NAME" label="$full_label"
fi


